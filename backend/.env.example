# Copy to backend/.env when running the API outside Docker.
# These defaults match the Postgres started by docker-compose.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bb_bloom
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bb_bloom_test
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
